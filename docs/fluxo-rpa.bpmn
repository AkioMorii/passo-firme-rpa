<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PassoFirme" targetNamespace="https://passofirme.example/rpa" exporter="Passo Firme RPA" exporterVersion="1.0">
  <bpmn:process id="Process_Triagem" name="Triagem automática de relatos de calçada" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Início">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_listar" name="Buscar relatos via GET /relatos">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_fila" name="Há relatos novos?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_validar" name="Validar foto, GPS, classe e confiança">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_dados" name="Dados válidos?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_duplicidade" name="Duplicado em 25 m / 48 h?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_confianca" name="Confiança &gt;= 0,65?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_priorizar" name="Calcular prioridade">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_consultar" name="Consultar POST /assistente">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_recusa" name="Assistente recusou?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_encaminhar" name="PATCH: encaminhado + canal simulado">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_revisar" name="PATCH: revisão humana">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_descartar" name="PATCH: descartado">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_auditar" name="Auditar resultado e tratar erros">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="Fim do lote">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Activity_listar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_listar" targetRef="Gateway_fila" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_fila" targetRef="End_1" name="Não" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_fila" targetRef="Activity_validar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_validar" targetRef="Gateway_dados" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_dados" targetRef="Activity_revisar" name="Não" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_dados" targetRef="Gateway_duplicidade" name="Sim" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_duplicidade" targetRef="Activity_descartar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_duplicidade" targetRef="Gateway_confianca" name="Não" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_confianca" targetRef="Activity_revisar" name="Não" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_confianca" targetRef="Activity_priorizar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_priorizar" targetRef="Activity_consultar" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_consultar" targetRef="Gateway_recusa" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_recusa" targetRef="Activity_revisar" name="Sim" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_recusa" targetRef="Activity_encaminhar" name="Não" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_encaminhar" targetRef="Activity_auditar" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_revisar" targetRef="Activity_auditar" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Activity_descartar" targetRef="Activity_auditar" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Activity_auditar" targetRef="Gateway_fila" name="Próximo" />
  </bpmn:process>
